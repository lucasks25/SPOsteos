# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
!.env.example

# uploads de anexos (fora de public/: servidos só pela rota autenticada)
/storage
/public/uploads

# ferramentas de agentes de IA (geradas localmente, não fazem parte do produto; padrões aninhados de propósito:
# já houve bancos de memória de agente versionados dentro de src/app)
.claude-flow/
**/.claude-flow/
.swarm/
**/.swarm/
/.agents
/.windsurf
**/ruvector.db*
**/agentdb*
**/*.rvf
**/*.rvf.*
/skills-lock.json
/.claude/*
!/.claude/agents

# bancos locais e dumps (nunca versionar dados)
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.age

# produção: segredos, certificados e backups nunca vão para o git (docs/PRODUCAO-SEGURA.md)
/secrets/
/certs/
/backups/
*.key
*.crt
*.p12
*.pfx

# manuais do Itaú (documentos do banco, um deles "Corporativo | Interno"): ficam só na máquina, fora do repositório público
docs/manuais/*.pdf
docs/manuais/*.txt
