# Desenvolvimento: o banco do docker-compose.yml (opme:opme, só em localhost). PRODUÇÃO: o sistema recusa subir com opme:opme
# ou sem TLS. Use o papel de menor privilégio (scripts/db-papel-app.sql, docs/LGPD.md §9), senha aleatória e sslmode:
# DATABASE_URL="postgresql://opme_app:<senha>@<host>:5432/opme?schema=public&sslmode=verify-full&sslrootcert=/etc/opme/pg-ca.crt"
# (o driver pg trata sslmode=require como verify-full: com certificado próprio do banco, aponte sslrootcert para ele; docs/PRODUCAO-SEGURA.md §3)
DATABASE_URL="postgresql://opme:opme@localhost:5440/opme?schema=public"
# Só se o banco estiver na mesma máquina/rede privada isolada (sem TLS possível). Padrão: vazio. Detalhes em docs/PRODUCAO-SEGURA.md.
# ALLOW_INSECURE_DB=1
# Conexões do pool do Postgres por processo (padrão 20). Mantenha a soma dos processos abaixo do max_connections do banco.
# DATABASE_POOL_MAX=20
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres; o sistema recusa valores de exemplo)
AUTH_SECRET=""
# Com mais de uma instância do app, TODAS precisam da mesma chave (cifra os IDs das Server Actions): openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Quantos proxies confiáveis (nginx, Caddy, balanceador) ficam à frente do app. 0 ou vazio = nenhum: o x-forwarded-for é IGNORADO
# (o limite de login vale só por e-mail). 1 = um proxy que acrescenta o IP do cliente ao x-forwarded-for. Máximo 5.
# Ligue só se o proxy sobrescreve/acrescenta o cabeçalho e a porta do app NÃO é acessível sem passar por ele.
TRUST_PROXY=0
# Chave de cifra dos dados sensíveis (carteirinha do paciente). 64 hex: openssl rand -hex 32. Rotação: "v2:<hex novo>,v1:<hex antigo>" (a primeira cifra; todas decifram). Guarde cópia fora do servidor: perdê-la = perder os dados cifrados.
DATA_KEY=
# Só desenvolvimento: senha dos usuários de demonstração do seed (o seed não roda em produção)
# SEED_PASSWORD="opme1234"

# Dados da empresa nos documentos impressos (vale, boleto, orçamento, comunicado).
# Vazio = usa o padrão de src/lib/empresa.ts (dados públicos do CNPJ na Receita Federal, consulta de 16/10/2026);
# telefone e e-mail não têm padrão. Os valores abaixo são os públicos (Receita e site sp-osteos.com.br); confira antes de produção.
EMPRESA_NOME="SP OSTEOS"
EMPRESA_RAZAO_SOCIAL="SP OSTEOS Distribuidora de Produtos para a Saúde Ltda"
EMPRESA_CNPJ="19.966.249/0001-84"
EMPRESA_ENDERECO="Rua Alegre, 470, sala 1001 - Santa Paula"
EMPRESA_CEP="09550-250"
EMPRESA_CIDADE="São Caetano do Sul - SP"
EMPRESA_TELEFONE="(11) 2311-0730"
EMPRESA_EMAIL="comercial@sp-osteos.com.br"
