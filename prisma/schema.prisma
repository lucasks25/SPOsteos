// Sistema de Gestão OPME — esquema de dados

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Acesso ─────────────────────────

enum Perfil {
  ADMIN
  COMERCIAL
  ESTOQUE
  QUALIDADE
  COMPRAS
  FINANCEIRO
}

model Usuario {
  id           String         @id @default(cuid())
  nome         String
  email        String         @unique
  senhaHash    String
  perfil       Perfil         @default(COMERCIAL)
  ativo        Boolean        @default(true)
  // Sobe a cada troca de senha e a cada logout: sessões (JWT) emitidas antes deixam de valer.
  sessaoVersao Int            @default(0)
  criadoEm     DateTime       @default(now())
  logs         LogAuditoria[]
}

// Tentativas de login que falharam (por e-mail e por IP) para limitar força bruta.
model TentativaLogin {
  id       String   @id @default(cuid())
  chave    String // "email:x@y" ou "ip:1.2.3.4"
  criadaEm DateTime @default(now())

  @@index([chave, criadaEm])
}

model LogAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?
  criadoEm   DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criadoEm]) // admin/auditoria: página ordenada por data (tabela que mais cresce)
}

// ───────────────────────── Cadastros ─────────────────────────

model Fabricante {
  id         String      @id @default(cuid())
  nome       String
  cnpj       String?
  pais       String?
  produtos   Produto[]
  documentos Documento[]
}

model Fornecedor {
  id           String         @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String         @unique
  ie           String?
  email        String?
  telefone     String?
  cidade       String?
  uf           String?
  afe          String? // Autorização de Funcionamento ANVISA
  // dados para pagamento (SISPAG): banco/agência/conta ou chave Pix
  bancoCodigo  String? // código de compensação, ex.: 341
  agencia      String?
  conta        String?
  contaDigito  String?
  chavePix     String?
  // aprovação dos dados de pagamento (dupla checagem): o SISPAG só paga se o hash de (cnpj + banco/agência/conta/dígito + Pix)
  // for igual ao aprovado. Quem alterou não aprova (financeiro/_lib/favorecidos-aprovacao.ts, docs/REVISAO.md §19).
  pagamentoAlteradoEm   DateTime?
  pagamentoAlteradoPor  String?
  pagamentoAprovadoHash String?
  pagamentoAprovadoEm   DateTime?
  pagamentoAprovadoPor  String?
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now())
  pedidos      PedidoCompra[]
  contasPagar  ContaPagar[]
  documentos   Documento[]
}

model Hospital {
  id                 String                  @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String                  @unique
  ie                 String?
  email              String?
  telefone           String?
  endereco           String?
  bairro             String? // endereço do pagador no boleto de cobrança
  cep                String?
  cidade             String?
  uf                 String?
  prazoPagamentoDias Int                     @default(30)
  ativo              Boolean                 @default(true)
  criadoEm           DateTime                @default(now())
  local              LocalEstoque?
  inventarios        InventarioConsignacao[]
  cirurgias          Cirurgia[]
  pedidos            PedidoVenda[]
  orcamentos         Orcamento[]
  contasReceber      ContaReceber[]
  tabelaPrecoId      String?
  tabelaPreco        TabelaPreco?            @relation(fields: [tabelaPrecoId], references: [id])
}

model Medico {
  id            String     @id @default(cuid())
  nome          String
  crm           String
  ufCrm         String
  especialidade String?
  email         String?
  telefone      String?
  ativo         Boolean    @default(true)
  cirurgias     Cirurgia[]

  @@unique([crm, ufCrm])
}

model Convenio {
  id               String      @id @default(cuid())
  nome             String
  registroAns      String?
  cnpj             String?
  ativo            Boolean     @default(true)
  /// false = a verificação de risco de glosa (autorização prévia) ignora as cirurgias deste convênio
  exigeAutorizacao Boolean     @default(true)
  cirurgias        Cirurgia[]
  orcamentos       Orcamento[]
}

model Procedimento {
  id            String             @id @default(cuid())
  codigoTuss    String?
  descricao     String
  especialidade String?
  itens         ProcedimentoItem[]
  cirurgias     Cirurgia[]
}

// Materiais padrão sugeridos para um procedimento (perfil do procedimento)
model ProcedimentoItem {
  id             String       @id @default(cuid())
  procedimentoId String
  procedimento   Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        Produto      @relation(fields: [produtoId], references: [id])
  quantidade     Int          @default(1)
}

model Representante {
  id              String        @id @default(cuid())
  nome            String
  cpfCnpj         String?
  email           String?
  telefone        String?
  comissaoPercent Decimal       @default(0) @db.Decimal(5, 2)
  ativo           Boolean       @default(true)
  cirurgias       Cirurgia[]
  pedidos         PedidoVenda[]
}

model Produto {
  id                String                      @id @default(cuid())
  codigo            String                      @unique
  descricao         String
  referencia        String? // referência do fabricante
  fabricanteId      String?
  fabricante        Fabricante?                 @relation(fields: [fabricanteId], references: [id])
  registroAnvisa    String?
  validadeRegistro  DateTime?
  classeRisco       String? // I, II, III, IV
  gtin              String? // GTIN / código de barras UDI-GS1
  ncm               String?
  unidade           String                      @default("UN")
  custoMedio        Decimal                     @default(0) @db.Decimal(14, 2)
  precoBase         Decimal                     @default(0) @db.Decimal(14, 2)
  estoqueMinimo     Int                         @default(0)
  controlaLote      Boolean                     @default(true)
  ativo             Boolean                     @default(true)
  criadoEm          DateTime                    @default(now())
  lotes             Lote[]
  saldos            Saldo[]
  movimentos        Movimento[]
  precos            TabelaPrecoItem[]
  procedimentoItens ProcedimentoItem[]
  kitItens          KitItem[]
  pedidoCompraItens PedidoCompraItem[]
  pedidoVendaItens  PedidoVendaItem[]
  orcamentoItens    OrcamentoItem[]
  remessaItens      RemessaItem[]
  autorizacaoItens  AutorizacaoItem[]
  consumos          CirurgiaConsumo[]
  inventarioItens   InventarioConsignacaoItem[]
  documentos        Documento[]
}

// ───────────────────────── Qualidade / Lotes ─────────────────────────

enum StatusLote {
  QUARENTENA
  LIBERADO
  NAO_CONFORME
  BLOQUEADO
  VENCIDO
}

model Lote {
  id                    String                      @id @default(cuid())
  produtoId             String
  produto               Produto                     @relation(fields: [produtoId], references: [id])
  numero                String
  serie                 String?
  fabricacao            DateTime?
  validade              DateTime
  status                StatusLote                  @default(QUARENTENA)
  criadoEm              DateTime                    @default(now())
  saldos                Saldo[]
  movimentos            Movimento[]
  inspecoes             Inspecao[]
  remessaItens          RemessaItem[]
  consumos              CirurgiaConsumo[]
  inventarioItens       InventarioConsignacaoItem[]
  recolhimentoLotes     RecolhimentoLote[]
  recolhimentoAlvos     RecolhimentoAlvo[]
  recolhimentoPacientes RecolhimentoPaciente[]

  @@unique([produtoId, numero])
}

model Inspecao {
  id             String     @id @default(cuid())
  loteId         String
  lote           Lote       @relation(fields: [loteId], references: [id])
  resultado      StatusLote // LIBERADO, NAO_CONFORME ou BLOQUEADO
  embalagemOk    Boolean    @default(true)
  rotulagemOk    Boolean    @default(true)
  documentacaoOk Boolean    @default(true)
  observacao     String?
  inspetor       String
  criadoEm       DateTime   @default(now())
}

// ───────────────────────── Estoque ─────────────────────────

enum TipoLocal {
  DEPOSITO
  HOSPITAL
  QUARENTENA
  NAO_CONFORME
}

model LocalEstoque {
  id                String                  @id @default(cuid())
  nome              String
  tipo              TipoLocal
  hospitalId        String?                 @unique
  hospital          Hospital?               @relation(fields: [hospitalId], references: [id])
  saldos            Saldo[]
  movOrigem         Movimento[]             @relation("origem")
  movDestino        Movimento[]             @relation("destino")
  remessas          Remessa[]
  inventarios       InventarioConsignacao[]
  recolhimentoAlvos RecolhimentoAlvo[]
}

model Saldo {
  id         String       @id @default(cuid())
  produtoId  String
  produto    Produto      @relation(fields: [produtoId], references: [id])
  loteId     String
  lote       Lote         @relation(fields: [loteId], references: [id])
  localId    String
  local      LocalEstoque @relation(fields: [localId], references: [id])
  quantidade Int          @default(0)

  @@unique([loteId, localId])
  @@index([produtoId])
}

enum TipoMovimento {
  ENTRADA // recebimento de compra
  REMESSA // envio em consignação ao hospital
  RETORNO // devolução do hospital
  CONSUMO // utilizado em cirurgia
  TRANSFERENCIA // entre locais internos (ex.: quarentena -> depósito)
  AJUSTE
  PERDA
}

// Kardex: cada linha é um movimento de quantidade de um lote
model Movimento {
  id         String        @id @default(cuid())
  tipo       TipoMovimento
  produtoId  String
  produto    Produto       @relation(fields: [produtoId], references: [id])
  loteId     String
  lote       Lote          @relation(fields: [loteId], references: [id])
  origemId   String?
  origem     LocalEstoque? @relation("origem", fields: [origemId], references: [id])
  destinoId  String?
  destino    LocalEstoque? @relation("destino", fields: [destinoId], references: [id])
  quantidade Int
  custoUnit  Decimal       @default(0) @db.Decimal(14, 2)
  documento  String? // ex.: "REM-12", "PC-3", "CIR-8"
  observacao String?
  usuario    String?
  criadoEm   DateTime      @default(now())

  @@index([produtoId, criadoEm])
  @@index([loteId])
}

// Caixa / kit padrão de instrumentais e implantes
model Kit {
  id        String    @id @default(cuid())
  codigo    String    @unique
  descricao String
  itens     KitItem[]
  remessas  Remessa[]
}

model KitItem {
  id         String  @id @default(cuid())
  kitId      String
  kit        Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto @relation(fields: [produtoId], references: [id])
  quantidade Int     @default(1)
}

enum StatusRemessa {
  ABERTA // em separação
  ENVIADA // no hospital
  CONFERIDA // retorno conferido, consumo apurado
  CANCELADA
}

// Vale / remessa de consignação para um hospital
model Remessa {
  id          Int           @id @default(autoincrement())
  localId     String // local do hospital
  local       LocalEstoque  @relation(fields: [localId], references: [id])
  cirurgiaId  String?
  cirurgia    Cirurgia?     @relation(fields: [cirurgiaId], references: [id])
  kitId       String?
  kit         Kit?          @relation(fields: [kitId], references: [id])
  status      StatusRemessa @default(ABERTA)
  observacao  String?
  enviadaEm   DateTime?
  conferidaEm DateTime?
  criadoEm    DateTime      @default(now())
  itens       RemessaItem[]

  @@index([cirurgiaId]) // remessas da cirurgia, _count da lista, cirurgias aguardando vale
}

model RemessaItem {
  id         String  @id @default(cuid())
  remessaId  Int
  remessa    Remessa @relation(fields: [remessaId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto @relation(fields: [produtoId], references: [id])
  loteId     String
  lote       Lote    @relation(fields: [loteId], references: [id])
  quantidade Int
  devolvido  Int     @default(0)
  consumido  Int     @default(0)

  @@index([remessaId]) // itens da remessa; FK em cascata
}

// ───────────────────────── Comercial ─────────────────────────

model TabelaPreco {
  id             String            @id @default(cuid())
  nome           String
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  itens          TabelaPrecoItem[]
  hospitais      Hospital[]
}

model TabelaPrecoItem {
  id        String      @id @default(cuid())
  tabelaId  String
  tabela    TabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto     @relation(fields: [produtoId], references: [id])
  preco     Decimal     @db.Decimal(14, 2)

  @@unique([tabelaId, produtoId])
}

enum StatusCirurgia {
  AGENDADA
  CONFIRMADA
  REALIZADA
  FATURADA
  CANCELADA
}

model Cirurgia {
  id                    String                 @id @default(cuid())
  numero                Int                    @unique @default(autoincrement())
  dataHora              DateTime
  hospitalId            String
  hospital              Hospital               @relation(fields: [hospitalId], references: [id])
  medicoId              String
  medico                Medico                 @relation(fields: [medicoId], references: [id])
  convenioId            String?
  convenio              Convenio?              @relation(fields: [convenioId], references: [id])
  procedimentoId        String?
  procedimento          Procedimento?          @relation(fields: [procedimentoId], references: [id])
  representanteId       String?
  representante         Representante?         @relation(fields: [representanteId], references: [id])
  paciente              String
  carteirinha           String?
  sus                   Boolean                @default(false)
  status                StatusCirurgia         @default(AGENDADA)
  observacao            String?
  criadoEm              DateTime               @default(now())
  remessas              Remessa[]
  consumos              CirurgiaConsumo[]
  pedido                PedidoVenda?
  anexos                Anexo[]
  recolhimentoPacientes RecolhimentoPaciente[]
  autorizacoes          AutorizacaoConvenio[]

  @@index([dataHora]) // lista (dataHora desc), agenda, painel, comissões (ARQ-13)
}

// Material efetivamente utilizado na cirurgia (folha de consumo / pós-cirúrgico)
model CirurgiaConsumo {
  id         String   @id @default(cuid())
  cirurgiaId String
  cirurgia   Cirurgia @relation(fields: [cirurgiaId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  loteId     String
  lote       Lote     @relation(fields: [loteId], references: [id])
  quantidade Int

  @@index([cirurgiaId]) // detalhe e _count da lista de cirurgias; FK em cascata
  @@index([loteId]) // rastreabilidade e recall: lote -> paciente
}

// ── Autorização prévia / guia do convênio ligada à cirurgia. O convênio é o da própria cirurgia (Cirurgia.convenioId).
// Uma cirurgia pode ter mais de uma guia (reenvio, complemento); a verificação soma as válidas.
enum StatusAutorizacao {
  SOLICITADA
  AUTORIZADA
  PARCIAL
  NEGADA
  EXPIRADA
}

model AutorizacaoConvenio {
  id           String            @id @default(cuid())
  cirurgiaId   String
  cirurgia     Cirurgia          @relation(fields: [cirurgiaId], references: [id], onDelete: Cascade)
  numeroGuia   String?
  senha        String? // senha / código de autorização do convênio
  status       StatusAutorizacao @default(SOLICITADA)
  solicitadaEm DateTime // dia (meia-noite UTC)
  autorizadaEm DateTime?
  validade     DateTime? // último dia em que a autorização vale
  observacao   String?
  criadoEm     DateTime          @default(now())
  itens        AutorizacaoItem[]

  @@index([cirurgiaId])
}

model AutorizacaoItem {
  id                   String              @id @default(cuid())
  autorizacaoId        String
  autorizacao          AutorizacaoConvenio @relation(fields: [autorizacaoId], references: [id], onDelete: Cascade)
  produtoId            String
  produto              Produto             @relation(fields: [produtoId], references: [id])
  quantidadeSolicitada Int
  quantidadeAutorizada Int                 @default(0)
  valorAutorizado      Decimal?            @db.Decimal(14, 2) // total autorizado do item, quando o convênio informa

  @@unique([autorizacaoId, produtoId])
}

model Anexo {
  id         String   @id @default(cuid())
  cirurgiaId String
  cirurgia   Cirurgia @relation(fields: [cirurgiaId], references: [id], onDelete: Cascade)
  nome       String
  url        String
  criadoEm   DateTime @default(now())
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  RECUSADO
}

model Orcamento {
  id         Int             @id @default(autoincrement())
  hospitalId String
  hospital   Hospital        @relation(fields: [hospitalId], references: [id])
  convenioId String?
  convenio   Convenio?       @relation(fields: [convenioId], references: [id])
  paciente   String?
  status     StatusOrcamento @default(RASCUNHO)
  validade   DateTime?
  observacao String?
  criadoEm   DateTime        @default(now())
  itens      OrcamentoItem[]
}

model OrcamentoItem {
  id          String    @id @default(cuid())
  orcamentoId Int
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produtoId   String
  produto     Produto   @relation(fields: [produtoId], references: [id])
  quantidade  Int
  precoUnit   Decimal   @db.Decimal(14, 2)
}

enum StatusPedidoVenda {
  ABERTO
  FATURADO
  CANCELADO
}

model PedidoVenda {
  id              Int               @id @default(autoincrement())
  hospitalId      String
  hospital        Hospital          @relation(fields: [hospitalId], references: [id])
  cirurgiaId      String?           @unique
  cirurgia        Cirurgia?         @relation(fields: [cirurgiaId], references: [id])
  representanteId String?
  representante   Representante?    @relation(fields: [representanteId], references: [id])
  status          StatusPedidoVenda @default(ABERTO)
  numeroNf        String?
  total           Decimal           @default(0) @db.Decimal(14, 2)
  custoTotal      Decimal           @default(0) @db.Decimal(14, 2)
  comissao        Decimal           @default(0) @db.Decimal(14, 2)
  criadoEm        DateTime          @default(now())
  faturadoEm      DateTime?
  centroCustoId   String?
  centroCusto     CentroCusto?      @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  itens           PedidoVendaItem[]
  contasReceber   ContaReceber[]

  @@index([status, faturadoEm]) // painel, comissões, DRE e gestão: faturados no período
}

model PedidoVendaItem {
  id         String      @id @default(cuid())
  pedidoId   Int
  pedido     PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto     @relation(fields: [produtoId], references: [id])
  loteNumero String?
  quantidade Int
  precoUnit  Decimal     @db.Decimal(14, 2)
  custoUnit  Decimal     @default(0) @db.Decimal(14, 2)
}

// ───────────────────────── Compras ─────────────────────────

enum StatusPedidoCompra {
  ABERTO
  PARCIAL
  RECEBIDO
  CANCELADO
}

model PedidoCompra {
  id              Int                   @id @default(autoincrement())
  fornecedorId    String
  fornecedor      Fornecedor            @relation(fields: [fornecedorId], references: [id])
  status          StatusPedidoCompra    @default(ABERTO)
  previsao        DateTime?
  importacao      Boolean               @default(false)
  invoice         String?
  numeroDi        String?
  observacao      String?
  criadoEm        DateTime              @default(now())
  itens           PedidoCompraItem[]
  contasPagar     ContaPagar[]
  // Importação (custo nacionalizado). Nacional: moeda BRL e câmbio nulo. Moeda estrangeira exige câmbio (CHECK no SQL).
  // Câmbio e despesas ficam travados depois do primeiro recebimento (compras/_lib/importacao-servico.ts).
  moeda           String                @default("BRL") @db.Char(3)
  cambio          Decimal?              @db.Decimal(12, 6) // reais por 1 unidade da moeda
  tipoCambio      TipoCambio?
  incoterm        String?
  dataInvoice     DateTime?
  dataRegistroDi  DateTime?
  dataDesembaraco DateTime?
  despesas        PedidoCompraDespesa[]
}

enum TipoCambio {
  PTAX
  CONTRATADO
}

enum TipoDespesaImportacao {
  FRETE_INTERNACIONAL
  SEGURO
  II
  IPI
  PIS_IMPORTACAO
  COFINS_IMPORTACAO
  ICMS
  AFRMM
  DESPACHANTE
  ARMAZENAGEM
  CAPATAZIA
  TRANSPORTE_NACIONAL
  OUTRA
}

enum CriterioRateio {
  VALOR
  QUANTIDADE
  PESO
}

/// Despesa aduaneira ou tributo de um pedido de importação, em reais. Só as que integram o custo são rateadas.
model PedidoCompraDespesa {
  id           String                @id @default(cuid())
  pedidoId     Int
  pedido       PedidoCompra          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo         TipoDespesaImportacao
  descricao    String?
  valor        Decimal               @db.Decimal(14, 2)
  integraCusto Boolean
  criterio     CriterioRateio        @default(VALOR)
  itemId       String? // despesa só deste item (ex.: II de uma adição); nulo = rateia entre todos
  item         PedidoCompraItem?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  contaPagarId String?               @unique // conta a pagar própria (opcional)
  contaPagar   ContaPagar?           @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  criadoEm     DateTime              @default(now())

  @@index([pedidoId])
}

model PedidoCompraItem {
  id         String                @id @default(cuid())
  pedidoId   Int
  pedido     PedidoCompra          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto               @relation(fields: [produtoId], references: [id])
  quantidade Int
  recebido   Int                   @default(0)
  custoUnit  Decimal               @db.Decimal(14, 2) // SEMPRE em reais (na importação = preço na moeda × câmbio, estimativa até o recebimento)
  precoMoeda Decimal?              @db.Decimal(14, 4) // importação: preço unitário na moeda do pedido
  pesoKg     Decimal?              @db.Decimal(12, 3) // importação: peso líquido total da linha (rateio por peso)
  despesas   PedidoCompraDespesa[]
}

// ───────────────────────── Financeiro ─────────────────────────

enum StatusTitulo {
  ABERTO
  PAGO
  CANCELADO
}

model ContaReceber {
  id              String                @id @default(cuid())
  descricao       String
  hospitalId      String?
  hospital        Hospital?             @relation(fields: [hospitalId], references: [id])
  pedidoId        Int?
  pedido          PedidoVenda?          @relation(fields: [pedidoId], references: [id])
  valor           Decimal               @db.Decimal(14, 2)
  vencimento      DateTime
  status          StatusTitulo          @default(ABERTO)
  valorPago       Decimal?              @db.Decimal(14, 2) // acumulado das baixas (soma dos lançamentos)
  pagoEm          DateTime? // data da última baixa
  valorBaixado    Decimal?              @db.Decimal(14, 2) // Σ(principal + desconto) das baixas: quanto do título foi extinto
  criadoEm        DateTime              @default(now())
  // Cobrança bancária (boleto registrado). Estado: ENVIADO (na remessa), REGISTRADO (banco confirmou), REJEITADO, LIQUIDADO, BAIXADO.
  cobrancaContaId String?
  nossoNumero     String?
  cobrancaStatus  String?
  lancamentos     Lancamento[]
  cobrancaItens   RemessaCobrancaItem[]
  glosas          Glosa[]
  planoContaId    String?
  planoConta      PlanoConta?           @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  centroCustoId   String?
  centroCusto     CentroCusto?          @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  competencia     DateTime // mês/dia de competência (meia-noite UTC): o DRE usa esta data, não o vencimento

  @@unique([cobrancaContaId, nossoNumero])
  @@index([status, vencimento]) // listas (padrão ABERTO), totais, painel, fluxo, aging, conciliação
}

model ContaPagar {
  id                String                 @id @default(cuid())
  descricao         String
  fornecedorId      String?
  fornecedor        Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  pedidoId          Int?
  pedido            PedidoCompra?          @relation(fields: [pedidoId], references: [id])
  categoria         String?
  // Aprovação do financeiro: conta que nasce de recebimento de compra fica pendente (aprovadoEm nulo) e não entra em remessa SISPAG até ser aprovada.
  aprovadoEm        DateTime?
  aprovadoPor       String?
  // Segregação de funções (docs/REVISAO.md §21): quem criou à mão (nulo = gerada por outro módulo) e quem alterou valor,
  // vencimento, fornecedor ou boleto desde a última aprovação não aprovam a conta (financeiro/_lib/aprovacao-servico.ts).
  criadoPor         String?
  alteradoPor       String[]               @default([])
  codigoBarras      String? // boleto do fornecedor: 44 dígitos do código de barras
  valor             Decimal                @db.Decimal(14, 2)
  vencimento        DateTime
  status            StatusTitulo           @default(ABERTO)
  valorPago         Decimal?               @db.Decimal(14, 2) // acumulado das baixas (soma dos lançamentos)
  pagoEm            DateTime? // data da última baixa
  valorBaixado      Decimal?               @db.Decimal(14, 2) // Σ(principal + desconto) das baixas: quanto do título foi extinto
  criadoEm          DateTime               @default(now())
  lancamentos       Lancamento[]
  pagamentos        RemessaPagamentoItem[]
  planoContaId      String?
  planoConta        PlanoConta?            @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  centroCustoId     String?
  centroCusto       CentroCusto?           @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  competencia       DateTime // mês/dia de competência (meia-noite UTC): o DRE usa esta data, não o vencimento
  despesaImportacao PedidoCompraDespesa?

  @@index([status, vencimento]) // idem; aprovações e remessa SISPAG
}

enum TipoConta {
  BANCO
  CAIXA
}

enum SentidoLancamento {
  ENTRADA
  SAIDA
}

enum FormaPagamento {
  PIX
  BOLETO
  TED
  DINHEIRO
  CARTAO
  CHEQUE
  OUTRO
}

// Conta bancária ou caixa: onde o dinheiro entra e sai.
model ContaBancaria {
  id                         String             @id @default(cuid())
  nome                       String
  tipo                       TipoConta          @default(BANCO)
  banco                      String?
  agencia                    String?
  numero                     String?
  saldoInicial               Decimal            @default(0) @db.Decimal(14, 2)
  titularCnpj                String? // empresa debitada nos pagamentos (SISPAG)
  titularNome                String?
  // Cobrança dos hospitais (CNAB 400 Itaú, carteira 109): só habilita se a carteira estiver preenchida.
  carteiraCobranca           String?
  proximoNossoNumero         Int                @default(1) // sequência do nosso número (8 dígitos) desta conta
  cobrancaMultaPercent       Decimal            @default(2) @db.Decimal(5, 2)
  cobrancaJurosMensalPercent Decimal            @default(1) @db.Decimal(5, 2)
  ativo                      Boolean            @default(true)
  criadoEm                   DateTime           @default(now())
  lancamentos                Lancamento[]
  extrato                    ExtratoLinha[]
  remessas                   RemessaPagamento[]
  remessasCobranca           RemessaCobranca[]
}

// Movimento real de dinheiro numa conta (baixa de título ou lançamento avulso).
// `valor` é sempre positivo; o sentido define se entra ou sai.
model Lancamento {
  id              String            @id @default(cuid())
  contaId         String
  conta           ContaBancaria     @relation(fields: [contaId], references: [id])
  data            DateTime
  sentido         SentidoLancamento
  valor           Decimal           @db.Decimal(14, 2)
  descricao       String
  forma           FormaPagamento?
  categoria       String? // só para lançamentos avulsos (tarifa, rendimento, transferência...)
  contaReceberId  String?
  contaReceber    ContaReceber?     @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  contaPagarId    String?
  contaPagar      ContaPagar?       @relation(fields: [contaPagarId], references: [id], onDelete: Restrict)
  // Baixa de título: valor (dinheiro) = principal + juros + multa; o desconto extingue título sem dinheiro (CHECK no banco). Em avulso/transferência principal é null.
  principal       Decimal?          @db.Decimal(14, 2)
  juros           Decimal           @default(0) @db.Decimal(14, 2)
  multa           Decimal           @default(0) @db.Decimal(14, 2)
  desconto        Decimal           @default(0) @db.Decimal(14, 2)
  transferenciaId String?
  transferencia   Transferencia?    @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)
  // Classificação do lançamento AVULSO (baixa herda do título; transferência não tem). CHECK no banco.
  planoContaId    String?
  planoConta      PlanoConta?       @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  centroCustoId   String?
  centroCusto     CentroCusto?      @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  extrato         ExtratoLinha?
  criadoEm        DateTime          @default(now())

  @@index([contaId, data])
  @@index([contaReceberId])
  @@index([contaPagarId])
  @@index([transferenciaId])
  @@index([data]) // painel, fluxo e "pago no período": intervalo de datas sem filtrar conta
}

// Transferência entre contas próprias: par de lançamentos (SAIDA na origem, ENTRADA no destino).
// Não conta como entrada/saída do mês no painel nem como realizado do fluxo; conta no saldo de cada conta.
model Transferencia {
  id          String       @id @default(cuid())
  data        DateTime
  valor       Decimal      @db.Decimal(14, 2)
  descricao   String
  criadoEm    DateTime     @default(now())
  lancamentos Lancamento[]
}

// Linha do extrato bancário importado (OFX). `valor` é assinado: crédito > 0, débito < 0.
// Conciliada quando está ligada a um Lancamento.
model ExtratoLinha {
  id           String        @id @default(cuid())
  contaId      String
  conta        ContaBancaria @relation(fields: [contaId], references: [id])
  data         DateTime
  valor        Decimal       @db.Decimal(14, 2)
  descricao    String
  fitid        String // identificador único da transação (FITID do OFX ou chave do CNAB)
  origem       String        @default("OFX") // OFX | CNAB
  lancamentoId String?       @unique
  lancamento   Lancamento?   @relation(fields: [lancamentoId], references: [id])
  conciliadoEm DateTime?
  importadoEm  DateTime      @default(now())

  @@unique([contaId, fitid])
  @@index([contaId, data])
}

// Remessa de pagamentos SISPAG (Itaú). Um arquivo por remessa; Pix sempre em arquivo separado.
model RemessaPagamento {
  id              Int                    @id @default(autoincrement())
  contaId         String
  conta           ContaBancaria          @relation(fields: [contaId], references: [id])
  modo            String // TED_BOLETO | PIX
  dataPagto       DateTime
  conteudo        String // arquivo CNAB 240 gerado
  criadoEm        DateTime               @default(now())
  retornoEm       DateTime?
  canceladaEm     DateTime?
  canceladaMotivo String?
  itens           RemessaPagamentoItem[]
}

enum StatusPagamentoBanco {
  ENVIADO
  AGENDADO
  PAGO
  REJEITADO
  CANCELADO // remessa cancelada antes do envio: o título volta a poder entrar em outra remessa
}

// Um pagamento dentro da remessa. `id` vira o "seu número" (SP<id>) que volta no retorno.
model RemessaPagamentoItem {
  id           Int                  @id @default(autoincrement())
  remessaId    Int
  remessa      RemessaPagamento     @relation(fields: [remessaId], references: [id], onDelete: Cascade)
  contaPagarId String
  contaPagar   ContaPagar           @relation(fields: [contaPagarId], references: [id])
  forma        String // 01 | 41 | 45 | 30 | 31 (nota 5 do manual)
  valor        Decimal              @db.Decimal(14, 2)
  status       StatusPagamentoBanco @default(ENVIADO)
  ocorrencias  String?
  nossoNumero  String?

  @@index([contaPagarId])
}

// ───────────── Plano de contas e centros de custo (DRE gerencial) ─────────────

enum TipoPlano {
  RECEITA
  DEDUCAO
  CUSTO
  DESPESA
  RECEITA_FINANCEIRA
  DESPESA_FINANCEIRA
  IMPOSTO_LUCRO
  NAO_RESULTADO // estoque, empréstimo, aporte, distribuição de lucro: fora do DRE
}

model PlanoConta {
  id           String       @id @default(cuid())
  codigo       String       @unique // "3.1.01"
  nome         String
  tipo         TipoPlano // o filho tem o mesmo tipo do pai (regra do app)
  paiId        String?
  pai          PlanoConta?  @relation("arvore", fields: [paiId], references: [id], onDelete: Restrict)
  filhos       PlanoConta[] @relation("arvore")
  analitica    Boolean      @default(true) // só a analítica recebe título ou lançamento
  chaveSistema String?      @unique // contas que o sistema usa sozinho (RECEITA_VENDA, ESTOQUE, JUROS_PAGOS...)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())

  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]
  lancamentos   Lancamento[]
}

model CentroCusto {
  id       String   @id @default(cuid())
  codigo   String   @unique
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]
  lancamentos   Lancamento[]
  pedidosVenda  PedidoVenda[]
}

enum CategoriaGlosa {
  SEM_AUTORIZACAO
  DIVERGENCIA_MATERIAL_GUIA
  SEM_JUSTIFICATIVA_TECNICA
  ADMINISTRATIVA
  TECNICA
  LINEAR
  OUTRA
}

enum RecursoGlosa {
  NENHUM
  EM_RECURSO
  REVERTIDA
  MANTIDA
}

// Glosa: o hospital não reconhece parte da cobrança. Extingue parte do título sem dinheiro (entra em valorBaixado)
// e vai para Deduções no DRE (conta GLOSA), na data da glosa. Não é desconto: desconto vai para o resultado financeiro.
model Glosa {
  id             String         @id @default(cuid())
  contaReceberId String
  contaReceber   ContaReceber   @relation(fields: [contaReceberId], references: [id], onDelete: Restrict)
  valor          Decimal        @db.Decimal(14, 2)
  data           DateTime
  motivo         String
  categoria      CategoriaGlosa @default(OUTRA)
  // Recurso ao convênio/hospital. REVERTIDA = glosa desfeita: o registro fica (histórico e relatório), mas
  // deixa de abater o título e de entrar no DRE (recalcularTitulo e o DRE ignoram). MANTIDA e EM_RECURSO não mexem em saldo.
  recurso        RecursoGlosa   @default(NENHUM)
  recursoEm      DateTime?
  criadoEm       DateTime       @default(now())

  @@index([contaReceberId])
  @@index([data])
}

// Mês financeiro fechado: nenhuma baixa, glosa, transferência, lançamento avulso ou título (por competência) com data
// naquele mês pode ser criado, alterado ou estornado. Reabrir apaga a linha (com motivo na auditoria).
model FechamentoMes {
  mes       String   @id // "yyyy-mm"
  fechadoEm DateTime @default(now())
  usuarioId String?
}

// ───────────── Cobrança dos hospitais (CNAB 400 Itaú, carteira 109) ─────────────

enum StatusCobrancaItem {
  ENVIADO
  CONFIRMADO
  REJEITADO
  LIQUIDADO
  BAIXADO
  CANCELADO
}

model RemessaCobranca {
  id              Int                   @id @default(autoincrement())
  contaId         String
  conta           ContaBancaria         @relation(fields: [contaId], references: [id])
  conteudo        String
  criadaEm        DateTime              @default(now())
  retornoEm       DateTime?
  canceladaEm     DateTime?
  canceladaMotivo String?
  itens           RemessaCobrancaItem[]
}

// ocorrencia: 01 entrada de título, 02 pedido de baixa, 06 alteração de vencimento. `id` não vai ao banco: o "seu número" é CR<contaReceberId> truncado em 10, então a ligação é pelo nosso número.
model RemessaCobrancaItem {
  id             Int                @id @default(autoincrement())
  remessaId      Int
  remessa        RemessaCobranca    @relation(fields: [remessaId], references: [id], onDelete: Cascade)
  contaReceberId String
  contaReceber   ContaReceber       @relation(fields: [contaReceberId], references: [id])
  ocorrencia     String // 01 | 02 | 06
  nossoNumero    String
  valor          Decimal            @db.Decimal(14, 2)
  vencimento     DateTime? // 06: novo vencimento pedido; vai para o título quando o banco confirma (retorno 14)
  status         StatusCobrancaItem @default(ENVIADO)
  motivos        String?

  @@index([contaReceberId])
  @@index([remessaId])
}

// Evento de retorno já processado: reprocessar o mesmo arquivo não baixa duas vezes.
model CobrancaEvento {
  id          String   @id @default(cuid())
  contaId     String
  nossoNumero String
  codigo      String
  data        DateTime
  criadoEm    DateTime @default(now())

  @@unique([contaId, nossoNumero, codigo, data])
}

// ───── Inventário de consignado nos hospitais (contagem física × saldo do sistema) ─────
enum StatusInventario {
  ABERTO
  CONTADO
  FECHADO
  CANCELADO
}

enum ResolucaoInventario {
  AJUSTE // corrige o saldo (falta vira PERDA no kardex; sobra vira AJUSTE)
  COBRAR_HOSPITAL // corrige o saldo e registra o valor a cobrar (só para falta); não cria título
  JUSTIFICADA // fica registrada, não mexe no saldo
}

// Documento "INV-<id>". Só um inventário aberto/contado por hospital (índice parcial no SQL da migration).
model InventarioConsignacao {
  id          Int                         @id @default(autoincrement())
  hospitalId  String
  hospital    Hospital                    @relation(fields: [hospitalId], references: [id])
  localId     String
  local       LocalEstoque                @relation(fields: [localId], references: [id])
  status      StatusInventario            @default(ABERTO)
  criadoEm    DateTime                    @default(now())
  criadoPor   String
  contadoEm   DateTime?
  fechadoEm   DateTime?
  fechadoPor  String?
  canceladoEm DateTime?
  observacao  String?
  itens       InventarioConsignacaoItem[]

  @@index([hospitalId, status])
}

model InventarioConsignacaoItem {
  id              String                @id @default(cuid())
  inventarioId    Int
  inventario      InventarioConsignacao @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produtoId       String
  produto         Produto               @relation(fields: [produtoId], references: [id])
  loteId          String
  lote            Lote                  @relation(fields: [loteId], references: [id])
  saldoSistema    Int // "foto" do saldo no momento da criação (ou da inclusão do lote encontrado)
  contado         Int?
  valorUnit       Decimal               @db.Decimal(14, 2) // custo médio congelado na foto
  resolucao       ResolucaoInventario?
  justificativa   String?
  // preenchidos só no fechamento
  saldoFechamento Int? // saldo ATUAL no instante do fechamento (pode diferir da foto)
  diferenca       Int? // contado − saldoFechamento
  valorCobrar     Decimal?              @db.Decimal(14, 2)

  @@unique([inventarioId, loteId])
  @@index([produtoId])
}

// ───────────────────────── Documentos e licenças ─────────────────────────

enum TipoDocumento {
  AFE
  LICENCA_SANITARIA
  CBPAD
  ALVARA
  CERTIFICADO_BPF
  AUTORIZACAO_COMERCIALIZACAO
  REGISTRO_ANVISA
  IFU
  LAUDO
  CONTRATO
  OUTRO
}

enum EscopoDocumento {
  EMPRESA
  FORNECEDOR
  FABRICANTE
  PRODUTO
}

// Documento regulatório (licença, certificado, registro...). Nunca é apagado: vira inativo ou substituído (histórico regulatório).
// CHECKs na migration: exatamente a FK do escopo preenchida (nenhuma para EMPRESA); validade >= emissão; não substitui a si mesmo.
model Documento {
  id               String             @id
  tipo             TipoDocumento
  titulo           String
  numero           String?
  orgaoEmissor     String?
  emissao          DateTime?
  validade         DateTime? // nulo = sem vencimento
  escopo           EscopoDocumento
  fornecedorId     String?
  fornecedor       Fornecedor?        @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  fabricanteId     String?
  fabricante       Fabricante?        @relation(fields: [fabricanteId], references: [id], onDelete: Restrict)
  produtoId        String?
  produto          Produto?           @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  observacao       String?
  ativo            Boolean            @default(true)
  // renovação: o documento antigo aponta para o novo que o substituiu
  substituidoPorId String?            @unique
  substituidoPor   Documento?         @relation("Renovacao", fields: [substituidoPorId], references: [id], onDelete: Restrict)
  substituiu       Documento?         @relation("Renovacao")
  substituidoEm    DateTime?
  criadoEm         DateTime           @default(now())
  criadoPor        String?
  atualizadoEm     DateTime           @updatedAt
  arquivos         DocumentoArquivo[]

  @@index([escopo, tipo])
  @@index([validade])
  @@index([fornecedorId])
  @@index([fabricanteId])
  @@index([produtoId])
}

// Arquivo (versão) de um documento. O mais recente é o vigente. Caminho gerado pelo servidor (UUID), fora de public/.
model DocumentoArquivo {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id])
  nome        String // nome de exibição (sanitizado)
  caminho     String // <uuid>.<ext> dentro de storage/uploads/documentos/<documentoId>/
  mime        String
  tamanho     Int
  hash        String // sha256 hex
  criadoEm    DateTime  @default(now())
  criadoPor   String?

  @@index([documentoId, criadoEm])
}

// ───────────────────────── Recolhimento de lote / tecnovigilância ─────────────────────────

enum OrigemRecolhimento {
  ANVISA
  FABRICANTE
  INTERNO
}

enum ClasseRecolhimento {
  I // maior risco à saúde (classificação da ação de campo; confirmar critérios com a Qualidade)
  II
  III
}

enum StatusRecolhimento {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusAlvoRecolhimento {
  PENDENTE
  COMUNICADO
  RECOLHIDO
  SEM_SALDO
}

// Documento "REC-<id>". Ao abrir, os lotes são BLOQUEADOS (ver RecolhimentoLote). CONCLUIDO e CANCELADO são imutáveis.
model Recolhimento {
  id                 Int                    @id @default(autoincrement())
  origem             OrigemRecolhimento
  classe             ClasseRecolhimento
  motivo             String
  referencia         String? // número do alerta sanitário / comunicado do fabricante
  prazo              DateTime? // data limite (meia-noite UTC, como validades)
  status             StatusRecolhimento     @default(ABERTO)
  observacao         String?
  abertoEm           DateTime               @default(now())
  abertoPor          String
  concluidoEm        DateTime?
  concluidoPor       String?
  conclusao          String? // parecer final
  canceladoEm        DateTime?
  canceladoPor       String?
  motivoCancelamento String?
  lotes              RecolhimentoLote[]
  alvos              RecolhimentoAlvo[]
  pacientes          RecolhimentoPaciente[]
  acoes              RecolhimentoAcao[]

  @@index([status])
}

model RecolhimentoLote {
  id               String       @id @default(cuid())
  recolhimentoId   Int
  recolhimento     Recolhimento @relation(fields: [recolhimentoId], references: [id], onDelete: Cascade)
  loteId           String
  lote             Lote         @relation(fields: [loteId], references: [id])
  statusAnterior   StatusLote // status do lote antes do bloqueio
  bloqueadoPorEste Boolean // false = o lote já estava BLOQUEADO; o cancelamento não o desbloqueia

  @@unique([recolhimentoId, loteId])
  @@index([loteId])
}

model RecolhimentoAlvo {
  id                  String                 @id @default(cuid())
  recolhimentoId      Int
  recolhimento        Recolhimento           @relation(fields: [recolhimentoId], references: [id], onDelete: Cascade)
  loteId              String
  lote                Lote                   @relation(fields: [loteId], references: [id])
  localId             String
  local               LocalEstoque           @relation(fields: [localId], references: [id])
  saldoAbertura       Int // saldo do lote no local quando entrou no recolhimento
  quantidadeRecolhida Int                    @default(0)
  status              StatusAlvoRecolhimento @default(PENDENTE)
  comunicadoEm        DateTime?
  recolhidoEm         DateTime? // última baixa física
  justificativa       String? // permite concluir com saldo que não foi recolhido
  saldoFinal          Int? // saldo no local ao concluir (congela o relatório)

  @@unique([recolhimentoId, loteId, localId])
  @@index([localId])
}

// Uma linha por CirurgiaConsumo que usou o lote. Dado sensível (LGPD): só QUALIDADE e ADMIN veem.
model RecolhimentoPaciente {
  id             String       @id @default(cuid())
  recolhimentoId Int
  recolhimento   Recolhimento @relation(fields: [recolhimentoId], references: [id], onDelete: Cascade)
  consumoId      String // CirurgiaConsumo.id (sem FK: o consumo pode ser estornado depois)
  cirurgiaId     String
  cirurgia       Cirurgia     @relation(fields: [cirurgiaId], references: [id])
  loteId         String
  lote           Lote         @relation(fields: [loteId], references: [id])
  quantidade     Int
  comunicadoEm   DateTime?
  observacao     String?

  @@unique([recolhimentoId, consumoId])
  @@index([cirurgiaId])
}

model RecolhimentoAcao {
  id             String       @id @default(cuid())
  recolhimentoId Int
  recolhimento   Recolhimento @relation(fields: [recolhimentoId], references: [id], onDelete: Cascade)
  criadoEm       DateTime     @default(now())
  usuario        String
  tipo           String // ABERTURA, ATUALIZACAO, COMUNICADO, RECOLHIMENTO, JUSTIFICATIVA, PACIENTE, NOTA, CONCLUSAO, CANCELAMENTO
  descricao      String

  @@index([recolhimentoId, criadoEm])
}

// Token de idempotência de formulário (campo oculto gerado na renderização): o segundo envio do mesmo token é recusado.
// Gravado na mesma transação da mutação (se ela falha, o token fica livre). Linhas com mais de 7 dias são apagadas.
model FormularioEnviado {
  token     String   @id
  usuarioId String?
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
}
