# Supply chain (OWASP A03): não executa scripts de install/postinstall de pacotes de terceiros
# (@prisma/engines, esbuild, unrs-resolver...). Testado: npm ci + `npm run prisma:gerar` funciona igual.
# Depois de `npm ci`/`npm install`, rode `npm run prisma:gerar` (o postinstall do projeto não roda com esta opção).
ignore-scripts=true
audit-level=high
