{
  "name": "opme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "prisma db seed",
    "db:demo": "tsx scripts/demo-dados.ts",
    "admin:criar": "tsx scripts/criar-admin.ts",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --audit-level=high",
    "postinstall": "prisma generate",
    "prisma:gerar": "prisma generate",
    "test": "tsx --conditions=react-server --test \"tests/financeiro/*.test.ts\" \"tests/busca/*.test.ts\" \"tests/gestao/*.test.ts\" \"tests/compras/*.test.ts\" \"tests/estoque/*.test.ts\" \"tests/qualidade/*.test.ts\" \"tests/comercial/*.test.ts\" \"tests/arquitetura/*.test.ts\" \"tests/seguranca/*.test.ts\"",
    "arquitetura": "tsx scripts/verificar-arquitetura.ts",
    "test:db": "tsx --conditions=react-server --test --test-concurrency=1 \"tests/financeiro-db/*.test.ts\" \"tests/negocio-db/*.test.ts\"",
    "test:negocio": "tsx --conditions=react-server --test --test-concurrency=1 \"tests/negocio-db/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.6"
  }
}
